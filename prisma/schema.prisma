// Ziggy Alpha Hub Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  parent
  learner
}

model User {
  id             String    @id @default(uuid())
  email          String?   @unique
  hashedPassword String?
  role           UserRole
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  learner        Learner?
  parentLearners Learner[] @relation("ParentLearners")
}

model Learner {
  id          String    @id @default(uuid())
  userId      String?   @unique
  parentId    String
  displayName String
  dateOfBirth DateTime?
  examDate    DateTime?
  timezone    String    @default("Europe/London")
  avatarEmoji String    @default("🌟")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  parent        User           @relation("ParentLearners", fields: [parentId], references: [id])
  attempts      Attempt[]
  srsEntries    SrsEntry[]
  testRuns      TestRun[]
  masteryStates MasteryState[]
}

enum TimePriority {
  exam_critical
  core_skill
  enrichment
}

model Track {
  id                   String       @id
  name                 String
  description          String?
  timePriority         TimePriority @default(core_skill)
  defaultWeeklyMinutes Int          @default(120)
  configJson           Json?
  icon                 String       @default("📚")
  color                String       @default("#3B82F6")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  subjects      Subject[]
  topics        Topic[]
  items         Item[]
  attempts      Attempt[]
  srsEntries    SrsEntry[]
  testRuns      TestRun[]
  masteryStates MasteryState[]
}

model Subject {
  id          String   @id
  trackId     String
  name        String
  description String?
  icon        String   @default("📖")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  track         Track          @relation(fields: [trackId], references: [id])
  topics        Topic[]
  items         Item[]
  attempts      Attempt[]
  masteryStates MasteryState[]
}

enum TopicLevel {
  foundation
  intermediate
  advanced
}

model Topic {
  id            String     @id
  trackId       String
  subjectId     String
  name          String
  description   String?
  level         TopicLevel @default(foundation)
  prerequisites Json       @default("[]")
  masteryRules  Json       @default("{\"min_recent_attempts\": 10, \"min_accuracy\": 0.8, \"min_days_span\": 3}")
  tags          Json       @default("[]")
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  track         Track          @relation(fields: [trackId], references: [id])
  subject       Subject        @relation(fields: [subjectId], references: [id])
  items         Item[]
  attempts      Attempt[]
  srsEntries    SrsEntry[]
  masteryStates MasteryState[]
}

model Item {
  id         String   @id @default(uuid())
  trackId    String
  subjectId  String
  topicId    String
  typeId     String
  difficulty Int      @default(2)
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  track      Track      @relation(fields: [trackId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])
  topic      Topic      @relation(fields: [topicId], references: [id])
  attempts   Attempt[]
  srsEntries SrsEntry[]
}

model Attempt {
  id          String   @id @default(uuid())
  learnerId   String
  itemId      String
  trackId     String
  subjectId   String
  topicId     String
  timestamp   DateTime @default(now())
  isCorrect   Boolean
  score       Float    @default(0)
  timeTakenMs Int?
  errorType   String?
  rawResponse Json?
  testRunId   String?

  learner Learner  @relation(fields: [learnerId], references: [id])
  item    Item     @relation(fields: [itemId], references: [id])
  track   Track    @relation(fields: [trackId], references: [id])
  subject Subject  @relation(fields: [subjectId], references: [id])
  topic   Topic    @relation(fields: [topicId], references: [id])
  testRun TestRun? @relation(fields: [testRunId], references: [id])

  @@index([learnerId, topicId])
  @@index([learnerId, timestamp])
}

model SrsEntry {
  id             String   @id @default(uuid())
  learnerId      String
  itemId         String
  trackId        String
  topicId        String
  lastReviewedAt DateTime @default(now())
  nextDueAt      DateTime @default(now())
  intervalDays   Float    @default(1)
  easeFactor     Float    @default(2.5)
  reviewCount    Int      @default(0)
  lapseCount     Int      @default(0)

  learner Learner @relation(fields: [learnerId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])
  track   Track   @relation(fields: [trackId], references: [id])
  topic   Topic   @relation(fields: [topicId], references: [id])

  @@unique([learnerId, itemId])
  @@index([learnerId, nextDueAt])
}

enum TestMode {
  diagnostic
  mock
  mini_test
  practice
}

model TestRun {
  id            String    @id @default(uuid())
  learnerId     String
  trackId       String
  name          String
  mode          TestMode  @default(practice)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  totalScore    Float?
  maxScore      Float?
  sectionScores Json?
  timeLimitMins Int?

  learner  Learner   @relation(fields: [learnerId], references: [id])
  track    Track     @relation(fields: [trackId], references: [id])
  attempts Attempt[]

  @@index([learnerId, startedAt])
}

enum MasteryStatus {
  not_started
  learning
  practising
  nearly_there
  mastered
}

enum RagStatus {
  red
  amber
  green
}

model MasteryState {
  id             String        @id @default(uuid())
  learnerId      String
  trackId        String
  subjectId      String
  topicId        String
  percentCorrect Float         @default(0)
  attemptsCount  Int           @default(0)
  masteryStatus  MasteryStatus @default(not_started)
  rag            RagStatus     @default(red)
  lastUpdatedAt  DateTime      @default(now())

  learner Learner @relation(fields: [learnerId], references: [id])
  track   Track   @relation(fields: [trackId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  topic   Topic   @relation(fields: [topicId], references: [id])

  @@unique([learnerId, topicId])
  @@index([learnerId, trackId])
}
