# Ziggy Alpha Hub Environment Variables
# Copy this to .env.local and fill in your values

# Database - PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ziggy_alpha_hub?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Optional: OpenAI/Anthropic for AI features (future)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
